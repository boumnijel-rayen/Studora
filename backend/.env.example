# Copier vers .env (ou lancer `npm run setup:env` qui génère des secrets aléatoires).
# NE JAMAIS committer le fichier .env ni copier ces secrets dans l'application Flutter.

HOST=0.0.0.0
PORT=1337

# Secrets Strapi (générés aléatoirement par scripts/setup-env.js)
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe
ENCRYPTION_KEY=changeMe

# Durée de validité des JWT utilisateurs (session mobile)
JWT_EXPIRES_IN=7d

# Origines autorisées (CORS) pour la version Web de l'app. "*" acceptable en dev uniquement.
CORS_ORIGINS=*

# Base de données : sqlite (dev) ou postgres (prod)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=studora
# DATABASE_USERNAME=studora
# DATABASE_PASSWORD=
# DATABASE_SSL=false

