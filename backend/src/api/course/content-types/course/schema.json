{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "Course",
    "description": "Créneau de cours hebdomadaire dans l'emploi du temps"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "subject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subject.subject"
    },
    "subjectName": {
      "type": "string",
      "required": true
    },
    "room": {
      "type": "string",
      "required": true
    },
    "teacher": {
      "type": "string",
      "default": ""
    },
    "dayOfWeek": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 7
    },
    "startTime": {
      "type": "string",
      "required": true
    },
    "endTime": {
      "type": "string",
      "required": true
    },
    "colorIndex": {
      "type": "integer",
      "default": 0
    },
    "notes": {
      "type": "text",
      "default": ""
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}

